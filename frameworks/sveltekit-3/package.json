		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"autoprefixer": "^10.5.4",
		"mdsvex": "^0.12.8",
		"postcss": "^8.5.26",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.3",
		"vite": "^8.0.0"
	}
