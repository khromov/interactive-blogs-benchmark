{
  "name": "mochi",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "mochi-framework build",
    "start": "bun src/index.ts",
    "dev": "MODE=development bun src/index.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings 'attribute_illegal_colon:ignore' && tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rimraf .mochi"
  },
  "dependencies": {
    "mdsvex": "^0.12",
    "mochi-framework": "^0.9.1",
    "rehype-slug": "^6",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "svelte-check": "4.7.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "msgpackr-extract": "npm:@mochi-framework/msgpackr-extract-stub@*"
  },
  "patchedDependencies": {
    "svelte-check@4.7.4": "patches/svelte-check@4.7.4.patch"
  }
}
