---
const posts = [
  { slug: 'post1', title: 'First post' },
  { slug: 'post2', title: 'Second post' },
  { slug: 'post3', title: 'Third post' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Interactive blogs benchmark — Astro</title>
  </head>
  <body>
    <h1>Posts</h1>
    <ul>
      {posts.map((post) => (
        <li><a href={`/posts/${post.slug}/`}>{post.title}</a></li>
      ))}
    </ul>
  </body>
</html>
