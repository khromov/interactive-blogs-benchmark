node_modules/
results/latest-run.*
*.log
.DS_Store

# locally-provisioned Chrome for the Lighthouse run (see README dev container note)
chrome/

# framework build artifacts / installed deps
frameworks/*/node_modules/
frameworks/*/build/
frameworks/*/dist/
frameworks/*/.astro/
frameworks/*/.svelte-kit/
frameworks/*/.mochi/

# ...except the SvelteKit-2022 build, which is committed so running the benchmark
# needs no Node 16 / pnpm 6 toolchain (rebuild instructions in README).
!frameworks/sveltekit-2022/build/
!frameworks/sveltekit-2022/build/**
